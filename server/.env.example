PORT=3001
POCKETBASE_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please
OPENROUTER_API_KEY=sk-or-...
# deny : exclut les fournisseurs susceptibles de stocker les manuscrits
OPENROUTER_DATA_COLLECTION=deny
# Identifiants sur https://openrouter.ai/models. Les deux doivent gérer les sorties structurées.
AI_MODEL_CREATIVE=anthropic/claude-sonnet-5.5
AI_MODEL_FAST=anthropic/claude-haiku-5.5
# Retenté quand un modèle refuse un passage (thèmes sombres). Laisser vide pour désactiver.
AI_MODEL_REFUSAL_FALLBACK=anthropic/claude-opus-5
AI_EFFORT_CREATIVE=medium
MEMORY_FULLTEXT_TOKEN_LIMIT=100000
SUMMARY_COMPRESS_WORDS=3000
JOB_TIMEOUT_MINUTES=10
LOG_PROMPTS=true
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
