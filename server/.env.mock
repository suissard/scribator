# Développement sans clé API : le serveur parle au simulateur local (npm run dev:mock).
POCKETBASE_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=dev-superuser@scribator.test
PB_SUPERUSER_PASSWORD=dev-superuser-password
OPENROUTER_API_KEY=mock
OPENROUTER_BASE_URL=http://127.0.0.1:4010/api/v1
# La rédaction est simulée, mais la liste et les prix des modèles sont les vrais.
OPENROUTER_CATALOG_URL=https://openrouter.ai/api/v1/models
AI_MODEL_CREATIVE=nvidia/nemotron-3.5-super-vl:free
AI_MODEL_FAST=nvidia/nemotron-3.5-super-vl:free
# Un modèle gratuit exige cette valeur : c'est aussi ce que vérifie le simulateur.
OPENROUTER_DATA_COLLECTION=allow
LOG_PROMPTS=true
LOG_LEVEL=info
