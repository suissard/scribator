{
  "name": "@scribator/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/prompts dist/prompts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "try": "tsx --env-file-if-exists=.env scripts/try.ts",
    "dev:mock": "PORT=3001 tsx watch --env-file=.env.mock src/index.ts",
    "mock:openrouter": "tsx scripts/mock-openrouter.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "diff": "^9.0.0",
    "docx": "^9.15.2",
    "epub-gen-memory": "^1.1.2",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "openai": "^7.52.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "pocketbase": "^0.28.2",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
