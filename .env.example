# Variables de docker-compose.yml, pour la production
DOMAIN=scribator.example.com
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please
# Optionnel : compte admin de l'application créé par « npm run db:reset » (installation locale)
# PB_USER_EMAIL=
# PB_USER_PASSWORD=
# PB_USER_NAME=Admin
# Clé maître AES-256 (32 octets en hex) pour chiffrer les clés OpenRouter personnelles en base.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=
# Facultatif : clé OpenRouter partagée de repli (laisser vide pour imposer une clé personnelle à chaque utilisateur)
OPENROUTER_API_KEY=sk-or-...
# Identifiants sur https://openrouter.ai/models. Les deux premiers sont obligatoires et doivent gérer les sorties structurées.
AI_MODEL_CREATIVE=nvidia/nemotron-3.5-super-vl:free
AI_MODEL_FAST=nvidia/nemotron-3.5-super-vl:free
# Retenté quand un modèle refuse un passage. Laisser vide pour désactiver.
AI_MODEL_REFUSAL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
