# Variables de docker-compose.yml, pour la production
DOMAIN=scribator.example.com
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please
OPENROUTER_API_KEY=sk-or-...
# Identifiants sur https://openrouter.ai/models. Les deux premiers sont obligatoires et doivent gérer les sorties structurées.
AI_MODEL_CREATIVE=
AI_MODEL_FAST=
# Retenté quand un modèle refuse un passage. Laisser vide pour désactiver.
AI_MODEL_REFUSAL_FALLBACK=
